{
  "source": "https://github.com/splitwise/api-docs/tree/f7bdbe2d639b74c649ad3971d68bc4b5262cbb2c",
  "note": "Documented parameters of the endpoints this connector calls, copied from the spec at source. users__{index}__{property} stands for users__0__user_id and the like.",
  "endpoints": {
    "get_current_user": {"method": "GET", "query": [], "body": []},
    "get_groups": {"method": "GET", "query": [], "body": []},
    "get_friends": {"method": "GET", "query": [], "body": []},
    "get_categories": {"method": "GET", "query": [], "body": []},
    "get_expense/{id}": {"method": "GET", "query": [], "body": []},
    "get_expenses": {"method": "GET", "query": ["group_id", "friend_id", "dated_after", "dated_before",
                                                "updated_after", "updated_before", "limit", "offset"], "body": []},
    "get_comments": {"method": "GET", "query": ["expense_id"], "body": []},
    "create_expense": {"method": "POST", "query": [], "body": [
      "cost", "description", "details", "date", "repeat_interval", "currency_code", "category_id",
      "group_id", "split_equally", "users__{index}__{property}"]},
    "update_expense/{id}": {"method": "POST", "query": [], "body": [
      "cost", "description", "details", "date", "repeat_interval", "currency_code", "category_id",
      "group_id", "users__{index}__{property}"]},
    "delete_expense/{id}": {"method": "POST", "query": [], "body": []},
    "undelete_expense/{id}": {"method": "POST", "query": [], "body": []},
    "create_comment": {"method": "POST", "query": [], "body": ["expense_id", "content"]}
  },
  "share_properties": ["user_id", "email", "first_name", "last_name", "paid_share", "owed_share"]
}
